root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 2

[*.{md,json,yml,yaml,js,jsx,ts,tsx,css,scss,html,go,py,sh}]
charset = utf-8
end_of_line = lf

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
