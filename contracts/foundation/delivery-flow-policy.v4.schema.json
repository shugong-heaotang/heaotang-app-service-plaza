{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/foundation/delivery-flow-policy.v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","effective_at","compatible_item_policy_versions","migration","applications","checklist_provenance","wip","handoff","continuation","work_item_model","business_value_gate","completion"],
  "properties": {
    "contract_version":{"const":"delivery-flow-policy.v4"},
    "effective_at":{"type":"string","format":"date-time"},
    "compatible_item_policy_versions":{"const":["delivery-flow-policy.v1","delivery-flow-policy.v2","delivery-flow-policy.v3","delivery-flow-policy.v4"]},
    "migration":{
      "type":"object","additionalProperties":false,
      "required":["legacy_snapshot_commit","legacy_snapshot_path","legacy_cutover_work_id","legacy_work_ids_sha256","legacy_work_states_sha256","new_items_require_flow_policy","protocol","receipts"],
      "properties":{
        "legacy_snapshot_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "legacy_snapshot_path":{"const":"contracts/foundation/agent-collaboration.v1.json"},
        "legacy_cutover_work_id":{"type":"string"},
        "legacy_work_ids_sha256":{"$ref":"#/$defs/sha"},
        "legacy_work_states_sha256":{"$ref":"#/$defs/sha"},
        "new_items_require_flow_policy":{"const":true},
        "protocol":{
          "type":"object","additionalProperties":false,
          "required":["work_id","stages","exact_allowed_paths_sha256","fail_closed"],
          "properties":{
            "work_id":{"const":"AIW-20260728-ACTIVITY-ONLY-LIFECYCLE-MIGRATION-R1"},
            "stages":{"const":["activation-base","migration"]},
            "exact_allowed_paths_sha256":{"$ref":"#/$defs/sha"},
            "fail_closed":{"const":true}
          }
        },
        "receipts":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"object"}}
      }
    },
    "applications":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object"}},
    "checklist_provenance":{"type":"object"},
    "wip":{"type":"object"},
    "handoff":{"type":"object"},
    "continuation":{"type":"object"},
    "work_item_model":{"type":"object"},
    "business_value_gate":{"type":"object"},
    "completion":{"type":"object"}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
