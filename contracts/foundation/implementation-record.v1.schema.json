{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/foundation/implementation-record.v1.schema.json",
  "title": "Heaotang AI-assisted Implementation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "record_id", "title", "date", "status", "objective", "governance_checklist", "governance_inputs", "requirement_sources", "capabilities", "contracts", "decisions", "changed_areas", "verification", "evidence", "premises", "implementation_mode"],
  "properties": {
    "contract_version": { "const": "implementation-record.v1" },
    "record_id": { "type": "string", "pattern": "^IR-[0-9]{8}-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "implemented", "verified", "deployed", "superseded"] },
    "objective": { "type": "string", "minLength": 1 },
    "governance_checklist": { "type": "string", "minLength": 1 },
    "governance_inputs": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requirement_sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^foundation\\." }, "uniqueItems": true },
    "contracts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "decisions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "changed_areas": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "premises": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "implementation_mode": { "enum": ["ai-assisted", "human", "mixed"] }
  }
}
