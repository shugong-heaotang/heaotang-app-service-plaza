{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/foundation/governance-reading-list.v1.schema.json",
  "title": "Heaotang Governance Reading List v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "core", "module_overlays"],
  "properties": {
    "contract_version": { "const": "governance-reading-list.v1" },
    "core": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "module_overlays": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]+$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/repositoryPath" }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+[^/]$"
    }
  }
}
