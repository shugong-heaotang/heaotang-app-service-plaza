{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/foundation/agent-collaboration.v1.schema.json",
  "title": "Heaotang Agent Collaboration Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "integration_owner_role", "workspace_policy", "protected_paths", "work_items"],
  "properties": {
    "contract_version": { "const": "agent-collaboration.v1" },
    "integration_owner_role": { "type": "string", "minLength": 1 },
    "workspace_policy": { "const": "isolated-branch-and-worktree" },
    "protected_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "title", "owner", "owner_role", "status", "repository_root", "workspace_path", "branch", "base_commit", "allowed_paths", "started_with_clean_worktree", "preexisting_changes_acknowledged", "handoff_record"],
        "properties": {
          "work_id": { "type": "string", "pattern": "^AIW-[0-9]{8}-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "active", "handoff-ready", "integrated", "cancelled"] },
          "repository_root": { "type": "string", "minLength": 1 },
          "workspace_path": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "pattern": "^codex/[a-z0-9._/-]+$" },
          "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "started_with_clean_worktree": { "type": "boolean" },
          "preexisting_changes_acknowledged": { "type": "boolean" },
          "migration_note": { "type": ["string", "null"] },
          "handoff_record": { "type": ["string", "null"] },
          "flow_policy_version": { "const": "delivery-flow-policy.v1" },
          "flow_class": { "enum": ["business-stream", "supporting-checkpoint", "governance-repair"] },
          "business_stream_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "module_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "updated_at": { "type": "string", "format": "date-time" },
          "target_date": { "type": "string", "format": "date-time" },
          "next_checkpoint": { "type": "string", "minLength": 1 },
          "status_expires_at": { "type": "string", "format": "date-time" },
          "developer_role": { "type": "string", "minLength": 1 },
          "reviewer_role": { "type": "string", "minLength": 1 },
          "approver_role": { "type": "string", "minLength": 1 },
          "blocks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "does_not_block": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "auto_continue": { "type": "boolean" },
          "stop_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "customer_segment": { "type": "string", "minLength": 1 },
          "customer_problem": { "type": "string", "minLength": 1 },
          "value_event": { "type": "string", "minLength": 1 },
          "success_metric": { "type": "string", "minLength": 1 },
          "metric_target": { "type": "string", "minLength": 1 },
          "measurement_window": { "type": "string", "minLength": 1 },
          "end_to_end_owner_role": { "type": "string", "minLength": 1 },
          "commercial_hypothesis": { "type": "string", "minLength": 1 },
          "kill_condition": { "type": "string", "minLength": 1 },
          "journey_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
