    {
      "pattern_id": "RI-AGENT-SHARED-WORKSPACE-OVERWRITE",
      "title": "后序 Agent 在共享脏工作区覆盖或重写前序成果",
      "occurrence_count": 2,
      "status": "implemented",
      "owner_role": "平台集成负责人",
      "root_cause": "工作项没有独立分支和工作树，也没有基线、范围所有权及受控交接，后序 Agent 无法判断已有修改的归属和设计依据。",
      "occurrences": [
        { "date": "2026-07-10", "summary": "项目负责人报告后序 Agent 曾把前序 Agent 已完成修改重新改乱", "evidence": "docs/project-management/service-plaza/recurring-issue-audit-2026-07-10.md" },
        { "date": "2026-07-10", "summary": "当前平台收口工作从共享 master 脏工作区开始且包含大量未归属到独立工作项的变更", "evidence": "contracts/foundation/agent-collaboration.v1.json" }
      ],
      "systemic_fix": "一任务一分支一工作树，活动范围互斥；平台公共路径归平台集成负责人；以基线、实现记录和 Handoff 受控合并。",
      "prevention_gates": ["contracts/foundation/agent-collaboration.v1.json", "scripts/validate_agent_collaboration.py", "docs/decisions/0015-isolated-agent-work-and-controlled-integration.md"],
      "regression_evidence": []
    },
    {
      "pattern_id": "RI-TEST-OTP-CAPACITY-NOT-RESERVED",
      "title": "测试验收在发送验证码前未核对并预留 UTC 日额度",
      "occurrence_count": 2,
      "status": "implemented",
      "owner_role": "平台集成负责人",
      "root_cause": "测试账号计划只预算当前步骤的发送次数，没有在 API 与受控浏览器分别建立会话前读取服务端当日累计消耗，也没有把不同验收表面的独立会话计入同一账号容量。",
      "occurrences": [
        { "date": "2026-07-11", "summary": "生命导航 M4 前置阶段曾因验证码发送频率受限调整账号会话计划", "evidence": "docs/project-management/modules/life-navigation/LN-M4-001-preflight-plan.md" },
        { "date": "2026-07-11", "summary": "API UAT 后浏览器需要独立会话，但主账号当日 5 次额度已耗尽，登录后 UAT 无法执行", "evidence": "docs/project-management/modules/life-navigation/LN-M4-001-handoff.md" }
      ],
      "systemic_fix": "所有需要发送验证码的 API、浏览器和管理验收在开始前，按测试账号和验收表面汇总所需独立会话；使用只读门禁核对服务端 SQLite UTC 日计数，容量不足即失败关闭，不换号、不清计数、不改限流。",
      "prevention_gates": ["scripts/Test-TestAccountOtpCapacity.ps1"],
      "regression_evidence": ["docs/project-management/service-plaza/test-account-otp-capacity-gate-2026-07-11.md"]
    },
    {
      "pattern_id": "RI-CURRENT-CHECKLIST-MUTABLE-OVERLAY",
      "title": "切片成果更新必读 overlay 后使入口检查单不再 current",
      "occurrence_count": 2,
      "status": "implemented",
      "owner_role": "平台集成负责人",
      "root_cause": "派发只授权了入口检查单和第一次考试，却同时把本切片必须更新的 internal-dependencies.v1.json 纳入模块 overlay；入口时 SHA 正确，成果落盘后必然发生治理输入自修改，而旧快照又不可改写。",
      "occurrences": [
        { "date": "2026-07-12", "summary": "健康大管家 MVP-90 M0 更新内部依赖后，原 FC/Exam 无法作为最终 current 证据", "evidence": "docs/project-management/service-plaza/governance-current-snapshot-self-reference-2026-07-12.md" },
        { "date": "2026-07-12", "summary": "生命导航 LN-S2 P0/P1 更新内部依赖后触发相同的最终 current SHA 漂移", "evidence": "docs/project-management/service-plaza/governance-current-snapshot-self-reference-2026-07-12.md" }
      ],
      "systemic_fix": "派发阶段识别同时属于治理 overlay 与切片输出的可变文件，预先授权入口快照和最终 R2 current 快照；入口快照保留为不可修改历史，最终成果落盘后重新全文读取、重新考试并由 R2 IR 收口。",
      "prevention_gates": ["contracts/foundation/agent-collaboration.v1.json", "scripts/validate_development_checklists.py", "scripts/validate_governance_exams.py"],
      "regression_evidence": ["docs/project-management/service-plaza/governance-current-snapshot-self-reference-2026-07-12.md"]
    }
