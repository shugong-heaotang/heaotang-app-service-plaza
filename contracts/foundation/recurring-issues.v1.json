      "pattern_id": "RI-UTF8-MOJIBAKE",
      "title": "UTF-8 字节合法但 PowerShell 或历史注释显示乱码",
      "occurrence_count": 3,
      "status": "verified",
      "owner_role": "平台质量负责人",
      "root_cause": "只验证 UTF-8 字节是否合法，没有同时约束 PowerShell 解码、HTTP charset 和常见乱码内容模式。",
      "occurrences": [
        { "date": "2026-07-10", "summary": "PowerShell 读取 UTF-8 JSON 出现乱码", "evidence": "docs/project-management/service-plaza/foundation-acceptance-2026-07-10.md" },
        { "date": "2026-07-10", "summary": "API JSON 未声明 charset 导致中文套餐名误解码", "evidence": "docs/project-management/service-plaza/business-variable-acceptance-2026-07-10.json" },
        { "date": "2026-07-10", "summary": "club-plugin 留有历史 mojibake 注释", "evidence": "docs/project-management/service-plaza/recurring-issue-audit-2026-07-10.md" }
      ],
      "systemic_fix": "统一 PowerShell UTF-8 初始化、API JSON charset、跨仓库 BOM/严格 UTF-8/乱码特征扫描。",
      "prevention_gates": ["scripts/Test-TextEncoding.ps1"],
      "regression_evidence": ["docs/project-management/service-plaza/business-variable-acceptance-2026-07-10.json"]
    },
