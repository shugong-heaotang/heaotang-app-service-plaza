{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/foundation/module-internal-dependencies.v1.schema.json",
  "title": "Heaotang Module Internal Dependencies v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "module_version", "slice_id", "development_readiness", "acceptance_readiness", "dependencies"],
  "properties": {
    "contract_version": { "const": "module-internal-dependencies.v1" },
    "module_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "module_version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "slice_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "development_readiness": { "enum": ["no-go", "go"] },
    "acceptance_readiness": { "enum": ["no-go", "partial-go", "go"] },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "kind", "description", "status", "required_for_slice", "depends_on", "contracts", "evidence", "unresolved"],
        "properties": {
          "dependency_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "kind": { "enum": ["interface", "data", "policy", "configuration", "workflow", "acceptance"] },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "standardized", "implemented", "verified"] },
          "required_for_slice": { "type": "boolean" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "contracts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "unresolved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
