{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/life-navigation/dimension-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "contract_status", "authoritative_business_registry", "registry_frozen", "decision_status", "executable", "source_facts", "dimensions", "legacy_dimensions"],
  "properties": {
    "contract_version": {"const": "life-navigation.dimension-registry.v1"},
    "contract_status": {"const": "base-contract"},
    "authoritative_business_registry": {"const": false},
    "registry_frozen": {"const": false},
    "decision_status": {"const": "pending"},
    "executable": {"const": false},
    "source_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend_current_dimension_id", "backend_current_validation", "legacy_yun_decision", "synthetic_input_sha256"],
      "properties": {
        "frontend_current_dimension_id": {"const": "yun"},
        "backend_current_validation": {"const": "non-empty-and-length-only"},
        "legacy_yun_decision": {"const": "pending"},
        "synthetic_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposedDimension"}},
    "legacy_dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observed_dimension_id", "decision_status", "executable", "mapping_target", "compatibility_action"],
        "properties": {
          "observed_dimension_id": {"const": "yun"},
          "decision_status": {"const": "pending"},
          "executable": {"const": false},
          "mapping_target": {"type": "null"},
          "compatibility_action": {"const": "not-decided"}
        }
      }
    }
  },
  "$defs": {
    "proposedDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id", "dimension_version", "label", "sort_order", "active", "decision_status", "executable", "authority"],
      "properties": {
        "dimension_id": {"type": "string", "pattern": "^proposed-[a-z0-9-]+$"},
        "dimension_version": {"const": "proposed-v1"},
        "label": {"type": "string", "minLength": 1},
        "sort_order": {"type": "integer", "minimum": 1},
        "active": {"const": false},
        "decision_status": {"const": "pending"},
        "executable": {"const": false},
        "authority": {"const": "synthetic-decision-candidate-only"}
      }
    }
  }
}
