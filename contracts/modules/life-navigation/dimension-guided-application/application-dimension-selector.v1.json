{
  "contract_version": "life-navigation.application-dimension-selector.v1",
  "contract_status": "base-contract",
  "authoritative_business_contract": false,
  "operation": {
    "method": "POST",
    "path": "/api/v1/life-nav/records",
    "record_type": "application"
  },
  "selector": {
    "authority": "server",
    "decision_status": "pending",
