{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "catalog_kinds", "responsibility", "catalog_entry", "snapshots", "membership_plan", "repository", "error_codes", "no_go"],
  "properties": {
    "contract_version": {"const": "protection-mall.catalog.v1"},
    "catalog_kinds": {"type": "array", "const": ["product", "service", "course", "activity"]},
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "kind_product_type", "assurance_policy", "failure_mode"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "kind_product_type": {"type": "object", "required": ["product", "service", "course", "activity"]},
        "assurance_policy": {"type": "object", "required": ["protection_mall", "club_mall"]},
        "failure_mode": {"const": "fail_closed"}
      }
    },
    "catalog_entry": {"type": "object", "required": ["required_fields", "scene_ids", "publish_scope", "cross_seller_scope"]},
    "snapshots": {"type": "object", "required": ["price", "benefit", "mutation_policy", "copy_policy"]},
    "membership_plan": {"type": "object", "required": ["required_scope", "owner", "operations", "budget", "currency_policy", "overflow_policy", "replacement_policy"]},
    "repository": {"type": "object", "required": ["implementation", "concurrency", "external_io"], "properties": {"external_io": {"const": false}}},
    "error_codes": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^MALL_CATALOG_"}},
    "no_go": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}
  }
}
