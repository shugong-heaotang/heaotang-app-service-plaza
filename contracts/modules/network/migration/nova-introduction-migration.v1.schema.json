{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/network/nova-introduction-migration.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "scope", "executable", "source", "target", "status_mapping", "quarantine", "phases", "safety", "legacy_routes", "rollback"],
  "properties": {
    "contract_version": {"const": "network.nova-introduction-migration.v1"},
    "module_id": {"const": "network"},
    "scope": {"const": "temporary-or-explicit-test-database-only"},
    "executable": {"const": false},
    "source": {"$ref": "#/$defs/table"},
    "target": {
      "allOf": [
        {"$ref": "#/$defs/table"},
        {"type": "object", "required": ["legacy_key", "run_key"], "properties": {"legacy_key": {"const": "legacy_source_id"}, "run_key": {"const": "migration_run_id"}}}
      ]
    },
    "status_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["pending", "accepted", "rejected"],
      "properties": {"pending": {"const": "pending"}, "accepted": {"const": "accepted"}, "rejected": {"const": "rejected"}}
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["table", "reasons", "automatic_tenant_assignment"],
      "properties": {
        "table": {"const": "nova_introduction_quarantine"},
        "reasons": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["unknown_tenant", "invalid_participant", "invalid_status", "duplicate_semantics"]}},
        "automatic_tenant_assignment": {"const": false}
      }
    },
    "phases": {"type": "array", "const": ["Plan", "Apply", "Inspect", "Cleanup", "RestoreVerify"]},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["unique_run_id_required", "explicit_test_confirmation_required", "test_database_marker_required", "plan_mutation_count", "backup_required_before_apply", "single_transaction_apply", "double_write_allowed", "legacy_write_trigger_required", "cleanup_may_reenable_legacy_writes", "restore_may_reenable_legacy_writes", "production_paths_forbidden"],
      "properties": {
        "unique_run_id_required": {"const": true}, "explicit_test_confirmation_required": {"const": true}, "test_database_marker_required": {"const": true},
        "plan_mutation_count": {"const": 0}, "backup_required_before_apply": {"const": true}, "single_transaction_apply": {"const": true},
        "double_write_allowed": {"const": false}, "legacy_write_trigger_required": {"const": true},
        "cleanup_may_reenable_legacy_writes": {"const": false}, "restore_may_reenable_legacy_writes": {"const": false}, "production_paths_forbidden": {"const": true}
      }
    },
    "legacy_routes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["method", "path", "sunset_status", "successor"], "properties": {"method": {"enum": ["POST", "PUT"]}, "path": {"type": "string"}, "sunset_status": {"const": 410}, "successor": {"pattern": "^people\\.connection_"}}}
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["restore_target", "legacy_write_authority_after_restore", "unsafe_route_status_after_restore", "reverse_write_to_legacy"],
      "properties": {"restore_target": {"const": "isolated-copy"}, "legacy_write_authority_after_restore": {"const": "forbidden"}, "unsafe_route_status_after_restore": {"const": 410}, "reverse_write_to_legacy": {"const": false}}
    }
  },
  "$defs": {
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["table", "identity", "required_fields"],
      "properties": {"table": {"type": "string"}, "identity": {"type": "string"}, "legacy_key": {"type": "string"}, "run_key": {"type": "string"}, "required_fields": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}}}
    }
  }
}
