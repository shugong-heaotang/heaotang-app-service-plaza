{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "deterministic",
    "synthetic_only",
    "cases"
  ],
  "properties": {
    "fixture_version": {
      "const": "activity.fixtures.v3"
    },
    "deterministic": {
      "const": true
    },
    "synthetic_only": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "acceptance_id",
          "polarity",
          "expected_decision",
          "capability",
          "rule",
          "synthetic_input"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2}-(POS|NEG)$"
          },
          "acceptance_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36
          },
          "polarity": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "expected_decision": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "capability": {
            "type": "string",
            "minLength": 6
          },
          "rule": {
            "type": "string",
            "minLength": 5
          },
          "synthetic_input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authorized", "confirmed", "violated_rules"],
            "properties": {
              "authorized": {"type": "boolean"},
              "confirmed": {"type": "boolean"},
              "violated_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 5}}
            }
          }
        }
      }
    }
  }
}
