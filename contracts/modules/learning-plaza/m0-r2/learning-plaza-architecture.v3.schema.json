{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/learning-plaza/m0-r2/learning-plaza-architecture.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "project_type", "execution", "internal_apps", "connected_capabilities", "external_projects", "ownership", "review_policy", "nova_learning_assistant", "growth_event", "first_course_loop", "ports"],
  "properties": {
    "contract_version": {"const": "learning-plaza.architecture.v3"},
    "project_id": {"const": "learning-plaza"},
    "project_type": {"const": "independent-general-learning-platform"},
    "execution": {"type": "object", "additionalProperties": false, "required": ["executable", "mode", "environment"], "properties": {"executable": {"const": false}, "mode": {"const": "mock-only"}, "environment": {"const": "non-production"}}},
    "internal_apps": {"type": "array", "minItems": 7, "uniqueItems": true},
    "connected_capabilities": {"type": "array", "minItems": 5, "uniqueItems": true},
    "external_projects": {"type": "array", "minItems": 4, "uniqueItems": true},
    "ownership": {"type": "object", "required": ["learning_fact_owner", "club_default_role", "club_content_ownership_implicit", "knowledge_catalog_owner", "non_knowledge_catalog_owner"]},
    "review_policy": {"type": "object", "required": ["governance_owner", "default_sequence", "switches", "switch_change_policy", "both_disabled_policy", "mandatory_audit_fields"], "properties": {"switch_change_policy": {"const": "versioned-maker-checker"}, "mandatory_audit_fields": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true}}},
    "nova_learning_assistant": {"type": "object", "required": ["engine", "allowed_actions", "prohibited_actions", "minimum_citations", "visible_resources_only"], "properties": {"minimum_citations": {"type": "integer", "minimum": 1}, "visible_resources_only": {"const": true}}},
    "growth_event": {"type": "object", "required": ["event_type", "source_of_truth", "required", "consumers", "write_policy"], "properties": {"source_of_truth": {"const": "learning-plaza"}, "write_policy": {"const": "emit-versioned-event-never-write-consumer-database"}}},
    "first_course_loop": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true},
    "ports": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["port_id", "direction", "readiness", "failure_policy"], "properties": {"failure_policy": {"const": "fail-closed"}}}}
  }
}
