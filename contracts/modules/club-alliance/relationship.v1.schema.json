{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/club-alliance/relationship.v1.schema.json",
  "title": "Club Alliance Relationship Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "relationship_kind", "entity_kind", "source_entity_kind", "target_entity_kind", "policy", "lifecycle", "business_api_authorized", "decision_refs"],
  "properties": {
    "contract_version": {"const": "club-alliance.relationship.v1"},
    "relationship_kind": {"const": "club-federation"},
    "entity_kind": {"const": "club_relationship"},
    "source_entity_kind": {"const": "club"},
    "target_entity_kind": {"const": "club"},
    "policy": {"$ref": "#/$defs/policy"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "business_api_authorized": {"const": false},
    "decision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^D-CA-[0-9]{3}$"}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "config_source_ref", "missing_config_behavior", "family_alliance_reuse"],
      "properties": {
        "policy_id": {"const": "club-federation-policy"},
        "policy_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "config_source_ref": {"const": "contracts/foundation/business-variables.v1.json"},
        "missing_config_behavior": {"const": "fail-closed"},
        "family_alliance_reuse": {"const": "forbidden"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "states", "write_implementation"],
      "properties": {
        "status": {"const": "planned"},
        "states": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["proposed", "active", "suspended", "ended"]}},
        "write_implementation": {"const": "not-authorized-in-h0"}
      }
    }
  }
}
