{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/health-manager/r4/doctor-directory-recommendation.v1.schema.json",
  "title": "Health Manager R4 doctor directory and constrained recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "checkpoint", "status", "synthetic_only", "executable", "source", "directory_entry", "hard_eligibility_gates", "recommendation_pipeline", "training_governance", "commercial_neutrality", "recommendation_explanation", "human_review_and_exit", "ai_boundary", "pending_signoffs", "acceptance_scenarios", "blocks", "does_not_block", "no_go"],
  "properties": {
    "contract_version": {"const": "health-manager.r4.doctor-directory-recommendation.v1"},
    "module_id": {"const": "health-manager"},
    "checkpoint": {"const": "R4-C1"},
    "status": {"const": "contract-frozen-awaiting-independent-review"},
    "synthetic_only": {"const": true},
    "executable": {"const": false},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "authorization"],
      "properties": {
        "path": {"const": "C:/Users/shugo/Documents/项目最高负责人/health-cross-module-requirements/健康大管家-大益健康馆-学习广场-健康俱乐部需求补充-v1.0.md"},
        "sha256": {"const": "fc07676f9d0ab0dbaf1a4575457e4d1a67d642d1c483187e28a5b2c64e2a9012"},
        "authorization": {"const": "synthetic-contract-and-negative-test-only"}
      }
    },
    "directory_entry": {"$ref": "#/$defs/policy"},
    "hard_eligibility_gates": {"$ref": "#/$defs/policy"},
    "recommendation_pipeline": {"$ref": "#/$defs/policy"},
    "training_governance": {"$ref": "#/$defs/policy"},
    "commercial_neutrality": {"$ref": "#/$defs/policy"},
    "recommendation_explanation": {"$ref": "#/$defs/policy"},
    "human_review_and_exit": {"$ref": "#/$defs/policy"},
    "ai_boundary": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "pending_signoffs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/signoff"}},
    "acceptance_scenarios": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/scenario"}},
    "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "does_not_block": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "no_go": {"type": "array", "minItems": 21, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "$defs": {
    "policy": {"type": "object", "minProperties": 3, "additionalProperties": true},
    "nonEmptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signoff": {
      "type": "object", "additionalProperties": false, "required": ["signoff_id", "owner", "status", "executable", "blocks"],
      "properties": {
        "signoff_id": {"enum": ["medical-quality", "privacy-legal", "platform-security", "health-venue-operations"]},
        "owner": {"type": "string", "minLength": 2},
        "status": {"const": "pending-with-owner"},
        "executable": {"const": false},
        "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["scenario_id", "polarity", "assertion"],
      "properties": {
        "scenario_id": {"pattern": "^R4-A0(0[1-9]|1[0-6])$"},
        "polarity": {"enum": ["positive", "negative"]},
        "assertion": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
