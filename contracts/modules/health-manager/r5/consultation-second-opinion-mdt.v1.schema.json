{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/health-manager/r5/consultation-second-opinion-mdt.v1.schema.json",
  "title": "Health Manager R5 consultation second opinion and MDT v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "checkpoint", "status", "synthetic_only", "executable", "source", "referral_package", "human_intake_and_triage", "expert_solicitation", "responsible_care_governance", "second_opinion_governance", "audit_trail", "prohibited_modes", "ai_boundary", "pending_signoffs", "acceptance_scenarios", "blocks", "does_not_block", "no_go"],
  "properties": {
    "contract_version": {"const": "health-manager.r5.consultation-second-opinion-mdt.v1"},
    "module_id": {"const": "health-manager"},
    "checkpoint": {"const": "R5-C1"},
    "status": {"const": "contract-frozen-awaiting-independent-review"},
    "synthetic_only": {"const": true},
    "executable": {"const": false},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "authorization"],
      "properties": {
        "path": {"const": "C:/Users/shugo/Documents/项目最高负责人/health-cross-module-requirements/健康大管家-大益健康馆-学习广场-健康俱乐部需求补充-v1.0.md"},
        "sha256": {"const": "fc07676f9d0ab0dbaf1a4575457e4d1a67d642d1c483187e28a5b2c64e2a9012"},
        "authorization": {"const": "synthetic-contract-and-negative-test-only"}
      }
    },
    "referral_package": {"$ref": "#/$defs/policy"},
    "human_intake_and_triage": {"$ref": "#/$defs/policy"},
    "expert_solicitation": {"$ref": "#/$defs/policy"},
    "responsible_care_governance": {"$ref": "#/$defs/policy"},
    "second_opinion_governance": {"$ref": "#/$defs/policy"},
    "audit_trail": {"$ref": "#/$defs/policy"},
    "prohibited_modes": {"$ref": "#/$defs/policy"},
    "ai_boundary": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden": {"type": "array", "minItems": 17, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "pending_signoffs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/signoff"}},
    "acceptance_scenarios": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/scenario"}},
    "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "does_not_block": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "no_go": {"type": "array", "minItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "$defs": {
    "policy": {"type": "object", "minProperties": 3, "additionalProperties": true},
    "nonEmptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signoff": {
      "type": "object", "additionalProperties": false, "required": ["signoff_id", "owner", "status", "executable", "blocks"],
      "properties": {
        "signoff_id": {"enum": ["medical-quality", "qualified-medical-institution", "privacy-legal", "platform-security", "health-venue-operations"]},
        "owner": {"type": "string", "minLength": 2},
        "status": {"const": "pending-with-owner"},
        "executable": {"const": false},
        "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["scenario_id", "polarity", "assertion"],
      "properties": {
        "scenario_id": {"pattern": "^R5-A0(0[1-9]|1[0-8])$"},
        "polarity": {"enum": ["positive", "negative"]},
        "assertion": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
