  "server_denial_matrix": [
    {"condition":"unauthenticated","http_status":401,"error_id":"HM_AUTHENTICATION_REQUIRED","fail_closed_state":"no_read_no_write","audit":true,"recovery":"establish a valid authenticated session"},
    {"condition":"not_self_for_self_action","http_status":403,"error_id":"HM_RESOURCE_NOT_OWNED","fail_closed_state":"no_read_no_write","audit":true,"recovery":"use only the authenticated member's resource"},
    {"condition":"cross_member_reference","http_status":404,"error_id":"HM_RESOURCE_NOT_FOUND","fail_closed_state":"non_enumerating_no_read_no_write","audit":true,"recovery":"supply an authorized same-member reference"},
    {"condition":"no_active_service_relationship","http_status":403,"error_id":"HM_SERVICE_RELATIONSHIP_REQUIRED","fail_closed_state":"no_read_no_write","audit":true,"recovery":"establish an independently authorized active relationship"},
    {"condition":"role_insufficient","http_status":403,"error_id":"HM_ROLE_NOT_AUTHORIZED","fail_closed_state":"no_read_no_write","audit":true,"recovery":"use a subject with the exact approved role"},
    {"condition":"qualification_missing_or_expired","http_status":403,"error_id":"HM_QUALIFICATION_INVALID","fail_closed_state":"no_read_no_write","audit":true,"recovery":"independently verify a current qualification within scope"},
    {"condition":"authorization_missing_withdrawn_or_expired","http_status":403,"error_id":"HM_AUTHORIZATION_NOT_ACTIVE","fail_closed_state":"no_read_no_write_no_background_use","audit":true,"recovery":"member creates a new explicit authorization version; withdrawn grant is never reused"},
    {"condition":"resource_state_conflict","http_status":409,"error_id":"HM_RESOURCE_STATE_CONFLICT","fail_closed_state":"state_unchanged","audit":true,"recovery":"refresh and use an allowed transition"},
    {"condition":"version_conflict","http_status":409,"error_id":"HM_VERSION_CONFLICT","fail_closed_state":"version_unchanged","audit":true,"recovery":"reload the current version and explicitly retry"},
    {"condition":"template_unapproved_or_expired","http_status":422,"error_id":"HM_TEMPLATE_NOT_EXECUTABLE","fail_closed_state":"draft_or_current_state_unchanged","audit":true,"recovery":"independent reviewer approves a current template version"},
    {"condition":"information_insufficient","http_status":422,"error_id":"HM_INFORMATION_INSUFFICIENT","fail_closed_state":"missing_information","audit":true,"recovery":"member or authorized worker supplies the explicitly missing minimum data"},
    {"condition":"risk_or_discomfort_block","http_status":409,"error_id":"HM_HUMAN_REVIEW_REQUIRED","fail_closed_state":"paused_or_handoff_pending","audit":true,"recovery":"qualified human review records an allowed recovery point"},
    {"condition":"idempotency_key_same_key_different_payload","http_status":409,"error_id":"HM_IDEMPOTENCY_CONFLICT","fail_closed_state":"original_result_preserved","audit":true,"recovery":"do not mutate the original request; use a new key only for a deliberate new operation"},
    {"condition":"audit_write_failed","http_status":503,"error_id":"HM_AUDIT_WRITE_REQUIRED","fail_closed_state":"protected_operation_not_committed","audit":false,"recovery":"restore durable audit capability and retry with the same idempotency reference"},
    {"condition":"ai_policy_or_tool_not_allowed","http_status":403,"error_id":"HM_AI_RUNTIME_NOT_AUTHORIZED","fail_closed_state":"no_context_release_no_tool_call_no_draft_promotion","audit":true,"recovery":"satisfy explicit purpose, model policy, template and tool allowlist gates"}
  ],
  "minimum_audit_fields": ["event_id","actor_ref","actor_role","action","resource_type","resource_ref","purpose","authorization_version","policy_version","template_version","outcome","reason_or_error_id","occurred_at","correlation_id","request_ref","idempotency_ref"],
