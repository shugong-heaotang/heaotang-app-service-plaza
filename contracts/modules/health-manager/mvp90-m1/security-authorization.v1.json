  "threat_model": [
    {"threat_id":"T01","threat":"unauthorized read or write","controls":["default deny","exact role-action-resource check","purpose and grant check"],"verification":"negative tests for every subject-action pair"},
    {"threat_id":"T02","threat":"cross-member IDOR and enumeration","controls":["owner predicate before lookup result disclosure","404 non-enumerating denial","audit repeated attempts"],"verification":"two-member synthetic cross-reference suite"},
    {"threat_id":"T03","threat":"continued use after grant withdrawal or expiry","controls":["grant version checked at every protected operation","cache invalidation","no background continuation"],"verification":"withdraw/expire then read, write and AI retry all denied"},
    {"threat_id":"T04","threat":"role or qualification impersonation","controls":["server-derived role","independent qualification registry","scope and expiry check"],"verification":"forged claims and expired qualification denied"},
    {"threat_id":"T05","threat":"AI prompt injection or unauthorized tool use","controls":["untrusted content isolation","tool allowlist","minimum context","no final-state authority"],"verification":"synthetic injected profile text cannot expand tools, purpose or resources"},
    {"threat_id":"T06","threat":"template or policy supply-chain tampering","controls":["immutable version","independent approval","integrity digest","expiry and rollback"],"verification":"unapproved, modified and expired versions denied"},
    {"threat_id":"T07","threat":"replay and concurrent lost update","controls":["atomic idempotency","same-key payload binding","optimistic version check"],"verification":"replay, conflict and race tests"},
    {"threat_id":"T08","threat":"audit bypass or partial commit","controls":["audit in protected transaction/outbox boundary","audit failure denies commit","append-only access"],"verification":"fault injection proves no protected commit without durable audit"},
    {"threat_id":"T09","threat":"sensitive logs and support overreach","controls":["metadata-only audit","denylisted fields","role and ticket bounded support access"],"verification":"structured report secret/health-body scan and support negative tests"},
    {"threat_id":"T10","threat":"frontend authorization bypass","controls":["all decisions repeated server-side","direct API negative tests"],"verification":"hidden/disabled UI bypass attempts remain denied"}
  ],
  "premises": [
    {"premise_id":"P01","statement":"M1 is limited to an authenticated adult member acting for self with synthetic non-production data.","falsification_evidence":"minor, proxy, dependent, real-member or production scope is requested","review_trigger":"scope expansion","owner":"产品与隐私/法律负责人"},
