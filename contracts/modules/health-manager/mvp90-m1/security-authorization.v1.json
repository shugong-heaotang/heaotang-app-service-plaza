    {"premise_id":"P03","statement":"Qualification status and action scope can be independently verified at request time.","falsification_evidence":"qualification source is absent, stale, self-asserted or cannot express action scope","review_trigger":"qualification provider or policy changes","owner":"专业负责人和平台安全负责人"},
    {"premise_id":"P04","statement":"Authorization version, withdrawal and expiry are available synchronously for every protected operation.","falsification_evidence":"cached or asynchronous authorization permits use after withdrawal","review_trigger":"authorization storage or caching changes","owner":"隐私/法律负责人和平台安全负责人"},
    {"premise_id":"P05","statement":"AI runtime is a constrained delegate that cannot approve, activate or write final professional conclusions.","falsification_evidence":"a tool, model or workflow can promote its own output or widen its context","review_trigger":"model, tool, prompt, provider or autonomy changes","owner":"AI 与平台安全负责人"},
    {"premise_id":"P06","statement":"Protected writes can fail closed when durable audit recording fails.","falsification_evidence":"an implementation commits business state before audit durability is guaranteed","review_trigger":"transaction, queue or audit architecture changes","owner":"平台安全与运维负责人"}
  ],
