{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/health-manager/mvp90-m1/vertical-slice.v1.schema.json",
  "$defs": {
    "stepId": {"enum": ["M1-S01","M1-S02","M1-S03","M1-S04","M1-S05","M1-S06","M1-S07","M1-S08","M1-S09","M1-S10"]},
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id","sequence","name_zh","pdcar_phase","object_refs","machine_transition_refs","actor_roles","professional_boundary_refs","fail_closed_conditions","next_step_ids"],
      "properties": {
        "step_id": {"$ref": "#/$defs/stepId"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 10},
        "name_zh": {"type": "string", "minLength": 1},
        "pdcar_phase": {"enum": ["P","D","C","A","R"]},
        "object_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "machine_transition_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "actor_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["member","ai","health_manager","professional","platform"]}},
        "professional_boundary_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fail_closed_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "next_step_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stepId"}}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["contract_version","module_id","slice_id","scope","executable","prerequisite_refs","steps","invariants","pending_gates"],
  "properties": {
    "contract_version": {"const": "health-manager.mvp90-m1.vertical-slice.v1"},
    "module_id": {"const": "health-manager"},
    "slice_id": {"const": "health-mvp90-m1"},
    "scope": {"const": "adult synthetic-member PDCAR contract and conformance only"},
    "executable": {"const": false},
    "prerequisite_refs": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/step"},
      "allOf": [
        {"contains":{"properties":{"step_id":{"const":"M1-S01"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S02"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S03"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S04"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S05"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S06"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S07"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S08"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S09"}},"required":["step_id"]},"minContains":1,"maxContains":1},
        {"contains":{"properties":{"step_id":{"const":"M1-S10"}},"required":["step_id"]},"minContains":1,"maxContains":1}
      ]
    },
    "invariants": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pending_gates": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "C4-L02-L04"}}
  }
}
