{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/health-manager/mvp90-m1/security-authorization.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","decision","default_policy","subjects","resources","actions","server_denial_matrix","minimum_audit_fields","audit_forbidden_fields","threat_model","premises","review","forbidden_alternatives","external_dependencies"],
  "properties": {
    "contract_version": {"const":"health-manager.mvp90-m1.security-authorization.v1"},
    "decision": {"type":"object","required":["decision_id","decision_maker_role","decided_at","scope","version","status","executable","non_executable_reason"],"properties":{"decision_id":{"const":"C4-S04"},"decision_maker_role":{"const":"平台安全负责人"},"decided_at":{"type":"string","format":"date"},"scope":{"type":"string","minLength":1},"version":{"const":"v1"},"status":{"enum":["Accepted","Exact revision","Pending with owner"]},"executable":{"const":false},"non_executable_reason":{"type":"string","minLength":1}},"additionalProperties":false},
    "default_policy":{"const":"deny"},
    "subjects":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"object","required":["subject_id","kind","description","may_delegate"],"properties":{"subject_id":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"kind":{"enum":["human","workforce","machine"]},"description":{"type":"string","minLength":1},"may_delegate":{"const":false}},"additionalProperties":false}},
    "resources":{"type":"array","minItems":10,"items":{"type":"object","required":["resource_type","owner_rule","sensitivity"],"properties":{"resource_type":{"type":"string","minLength":1},"owner_rule":{"type":"string","minLength":1},"sensitivity":{"type":"string","minLength":1}},"additionalProperties":false}},
    "actions":{"type":"array","minItems":10,"items":{"type":"object","required":["action_id","subjects","resources","effect","prerequisites","prohibitions"],"properties":{"action_id":{"type":"string","pattern":"^[a-z][a-z0-9_.]+$"},"subjects":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"resources":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"effect":{"type":"string","minLength":1},"prerequisites":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"prohibitions":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false}},
    "server_denial_matrix":{"type":"array","minItems":14,"items":{"type":"object","required":["condition","http_status","error_id","fail_closed_state","audit","recovery"],"properties":{"condition":{"type":"string","minLength":1},"http_status":{"enum":[401,403,404,409,422,503]},"error_id":{"type":"string","pattern":"^HM_[A-Z0-9_]+$"},"fail_closed_state":{"type":"string","minLength":1},"audit":{"type":"boolean"},"recovery":{"type":"string","minLength":1}},"additionalProperties":false}},
    "minimum_audit_fields":{"type":"array","minItems":14,"items":{"type":"string"},"uniqueItems":true},
    "audit_forbidden_fields":{"type":"array","minItems":8,"items":{"type":"string"},"uniqueItems":true},
    "threat_model":{"type":"array","minItems":10,"items":{"type":"object","required":["threat_id","threat","controls","verification"],"properties":{"threat_id":{"type":"string","pattern":"^T[0-9]{2}$"},"threat":{"type":"string","minLength":1},"controls":{"type":"array","minItems":1,"items":{"type":"string"}},"verification":{"type":"string","minLength":1}},"additionalProperties":false}},
    "premises":{"type":"array","minItems":6,"items":{"type":"object","required":["premise_id","statement","falsification_evidence","review_trigger","owner"],"properties":{"premise_id":{"type":"string","pattern":"^P[0-9]{2}$"},"statement":{"type":"string","minLength":1},"falsification_evidence":{"type":"string","minLength":1},"review_trigger":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1}},"additionalProperties":false}},
    "review":{"type":"object","required":["scheduled_review_date","triggers","compatibility","migration"],"properties":{"scheduled_review_date":{"type":"string","format":"date"},"triggers":{"type":"array","minItems":5,"items":{"type":"string"}},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1}},"additionalProperties":false},
    "forbidden_alternatives":{"type":"array","minItems":5,"items":{"type":"string"},"uniqueItems":true},
    "external_dependencies":{"type":"array","minItems":3,"items":{"type":"object","required":["decision","owner","status","effect"],"properties":{"decision":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"status":{"const":"Pending with owner"},"effect":{"type":"string","minLength":1}},"additionalProperties":false}}
  }
}
