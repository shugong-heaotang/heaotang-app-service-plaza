{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/modules/health-manager/r3/learning-club-entry.v1.schema.json",
  "title": "Health Manager R3 learning and club entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "checkpoint", "status", "synthetic_only", "executable", "source", "authority_snapshots", "summary_access_policy", "navigation_policy", "member_confirmed_return", "module_isolation", "ai_boundary", "pending_signoffs", "acceptance_scenarios", "blocks", "does_not_block", "no_go"],
  "properties": {
    "contract_version": {"const": "health-manager.r3.learning-club-entry.v1"},
    "module_id": {"const": "health-manager"},
    "checkpoint": {"const": "R3-C1"},
    "status": {"const": "contract-frozen-awaiting-independent-review"},
    "synthetic_only": {"const": true},
    "executable": {"const": false},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "authorization"],
      "properties": {
        "path": {"const": "C:/Users/shugo/Documents/项目最高负责人/health-cross-module-requirements/健康大管家-大益健康馆-学习广场-健康俱乐部需求补充-v1.0.md"},
        "sha256": {"const": "fc07676f9d0ab0dbaf1a4575457e4d1a67d642d1c483187e28a5b2c64e2a9012"},
        "authorization": {"const": "synthetic-contract-and-negative-test-only"}
      }
    },
    "authority_snapshots": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/authority"}},
    "summary_access_policy": {"$ref": "#/$defs/policy"},
    "navigation_policy": {"$ref": "#/$defs/policy"},
    "member_confirmed_return": {"$ref": "#/$defs/policy"},
    "module_isolation": {"$ref": "#/$defs/policy"},
    "ai_boundary": {"$ref": "#/$defs/aiBoundary"},
    "pending_signoffs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/signoff"}},
    "acceptance_scenarios": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/scenario"}},
    "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "does_not_block": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "no_go": {"type": "array", "minItems": 17, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "$defs": {
    "nonEmptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "owns", "minimum_summary_fields", "canonical_route", "health_manager_permissions", "forbidden"],
      "properties": {
        "authority_id": {"enum": ["learning-plaza", "club-alliance"]},
        "owns": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "minimum_summary_fields": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "canonical_route": {"enum": ["/services/learning-plaza", "/services/club-alliance"]},
        "health_manager_permissions": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["read_authorized_minimum_summary", "navigate_to_authority"]}},
        "forbidden": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "policy": {"type": "object", "minProperties": 3, "additionalProperties": true},
    "aiBoundary": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "signoff": {
      "type": "object", "additionalProperties": false, "required": ["signoff_id", "owner", "status", "executable", "blocks"],
      "properties": {
        "signoff_id": {"enum": ["privacy-legal", "medical-quality", "platform-security", "module-operations"]},
        "owner": {"type": "string", "minLength": 2},
        "status": {"const": "pending-with-owner"},
        "executable": {"const": false},
        "blocks": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["scenario_id", "polarity", "assertion"],
      "properties": {
        "scenario_id": {"pattern": "^R3-A0(0[1-9]|1[0-4])$"},
        "polarity": {"enum": ["positive", "negative"]},
        "assertion": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
