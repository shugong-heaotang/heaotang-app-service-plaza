{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-brain-dashboard-policy.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "environment",
    "enabled",
    "production_enabled",
    "network_route_enabled",
    "real_sources_enabled",
    "export_enabled",
    "source_writes_enabled",
    "external_auth_enabled",
    "audience",
    "issuer",
    "allowed_roles",
    "max_session_seconds",
    "clock_skew_seconds",
    "max_state_file_bytes",
    "max_audit_bytes",
    "max_audit_entries"
  ],
  "properties": {
    "contract_version": {"const": "project-brain-dashboard-policy.v1"},
    "environment": {"enum": ["offline_synthetic_test", "production"]},
    "enabled": {"type": "boolean"},
    "production_enabled": {"const": false},
    "network_route_enabled": {"const": false},
    "real_sources_enabled": {"const": false},
    "export_enabled": {"const": false},
    "source_writes_enabled": {"const": false},
    "external_auth_enabled": {"const": false},
    "audience": {"type": "string", "minLength": 1, "maxLength": 128},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 128},
    "allowed_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["project_owner", "project_brain_reviewer", "platform_integration_owner"]}
    },
    "max_session_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
    "max_state_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "max_audit_bytes": {"type": "integer", "minimum": 1048576, "maximum": 16777216},
    "max_audit_entries": {"type": "integer", "minimum": 1, "maximum": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "production"}}, "required": ["environment"]},
      "then": {"properties": {"enabled": {"const": false}}}
    }
  ]
}
