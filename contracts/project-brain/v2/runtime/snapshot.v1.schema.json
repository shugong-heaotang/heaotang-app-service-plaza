{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-brain-snapshot.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "fact_id", "authority_id", "classification", "permitted_use", "definition", "captured_at", "input_hash", "source_hash", "contract_hashes", "result"],
  "properties": {
    "contract_version": {"const": "project-brain-snapshot.v1"},
    "run_id": {"type": "string"},
    "fact_id": {"type": "string"},
    "authority_id": {"type": "string"},
    "classification": {"enum": ["G0", "G1"]},
    "permitted_use": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "definition": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_hashes": {"type": "object", "required": ["catalog", "source_map", "privacy"], "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "result": {"type": "object"}
  }
}
