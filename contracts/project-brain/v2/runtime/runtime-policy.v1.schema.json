{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-brain-runtime-policy.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "enabled", "production_enabled", "production_route_enabled", "production_snapshot_source_enabled", "scheduled_production_job_enabled", "boss_dashboard_enabled", "export_enabled", "notification_enabled", "network_enabled", "real_sources_enabled", "source_writes_enabled", "external_notifications_enabled", "max_attempts", "timeout_seconds", "max_source_bytes", "schedule_interval_seconds", "allowed_fixtures"],
  "properties": {
    "contract_version": {"const": "project-brain-runtime-policy.v1"},
    "enabled": {"type": "boolean"},
    "production_enabled": {"const": false},
    "production_route_enabled": {"const": false},
    "production_snapshot_source_enabled": {"const": false},
    "scheduled_production_job_enabled": {"const": false},
    "boss_dashboard_enabled": {"const": false},
    "export_enabled": {"const": false},
    "notification_enabled": {"const": false},
    "network_enabled": {"const": false},
    "real_sources_enabled": {"const": false},
    "source_writes_enabled": {"const": false},
    "external_notifications_enabled": {"const": false},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "max_source_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "schedule_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "allowed_fixtures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^contracts/project-brain/v2/examples/[A-Za-z0-9._-]+\\.json$"}}
  }
}
