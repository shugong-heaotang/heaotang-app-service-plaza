{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heaotang.cn/contracts/project-brain/v2/source-map.v1.schema.json",
  "title": "Project Brain v2 source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "sources"],
  "properties": {
    "contract_version": {"const": "project-brain-source-map.v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "authority_id", "authority_uri", "source_owner", "classification", "source_status", "runtime_enabled", "read_mode", "write_capability", "evidence", "next_review_at"],
        "properties": {
          "fact_id": {"type": "string"},
          "authority_id": {"type": "string"},
          "authority_uri": {"type": "string", "minLength": 5},
          "source_owner": {"type": "string", "minLength": 3},
          "classification": {"enum": ["G0", "G1"]},
          "source_status": {"enum": ["verified_governance", "synthetic_only", "disabled"]},
          "runtime_enabled": {"const": false},
          "read_mode": {"const": "read_only"},
          "write_capability": {"const": "none"},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "next_review_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
